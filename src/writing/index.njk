---
layout: base.njk
title: Writing
---
<section>
  <div class="container">
    <div class="column-8">
      <h1>Writing</h1>
      {%- for post in collections.article | reverse %}
      <p><a href="{{ post.url }}">{{ post.data.title }}</a><br><em>{{ post.date | readableDate }}</em></p>
      {%- endfor %}
      <p><a class="back-link" href="/">←</a></p>
    </div>
  </div>
</section>
