---
layout: base.njk
title: Writing
description: "Roman(s) Bermans. Writing on technology, power, language, presence, and being human."
---
<section>
  <div class="container flow">
    <h1 class="page-title">Writing</h1>
    <div class="post-list">
    {%- for post in collections.article | reverse %}
      <article>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
      </article>
    {%- endfor %}
    </div>
    <p class="navigation-back"><a href="/">Home</a></p>
  </div>
</section>
